# Copy to .env (git-ignored).
# On Linux set this to your user id so files written into ../data and ./logs
# are owned by you:   sed -i "s/^AIRFLOW_UID=.*/AIRFLOW_UID=$(id -u)/" .env
AIRFLOW_UID=1000

# ghcnh = real NOAA GHCN-hourly observations (summarized to daily);
# synthetic = offline test data
WX_SOURCE=ghcnh

# GHCNh quality codes to drop: ISD convention, 2/6 suspect, 3/7 erroneous
# (see docs/OPERATIONS.md, Data source)
WX_REJECT_QC=2,3,6,7

# Optional: Slack-compatible incoming webhook for failure alerts
WX_ALERT_WEBHOOK=
