# Copy to .env (git-ignored).
# On Linux set this to your user id so files written into ../data and ./logs
# are owned by you:   sed -i "s/^AIRFLOW_UID=.*/AIRFLOW_UID=$(id -u)/" .env
AIRFLOW_UID=1000

# ncei = real GSOD from NCEI over HTTPS; synthetic = offline test data
WX_SOURCE=ncei

# Optional: Slack-compatible incoming webhook for failure alerts
WX_ALERT_WEBHOOK=
